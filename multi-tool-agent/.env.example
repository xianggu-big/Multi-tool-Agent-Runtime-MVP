# ============================================================
# multi-tool-agent — 环境变量示例模板
# ============================================================
# ⚠️ 这是**模板文件**，通常会被提交到 Git：请勿在此写入任何真实密钥！
#    真实配置请复制到 .env（已被 .gitignore 忽略），或在界面的「配置」面板里临时填写。
#
# 两种配置 API Key 的方式（二选一或混用）：
#   A) .env 文件：进程级默认值，服务重启后仍生效。
#   B) 前端配置面板：单次任务级覆盖，优先级高于 .env，
#      Key 仅用于该次运行，不写入 SQLite、不写入事件日志（已脱敏）。

# --- LLM 模式 ---
# mock  = 内置 Mock LLM（无需任何 Key，用于测试与演示，结果明确标注为模拟）
# openai = 调用真实 LLM（OpenAI 兼容接口，默认走下面的 LLM_PROVIDER 预设）
LLM_MODE=mock

# --- LLM Provider 预设（推荐：优先 DeepSeek）---
# 可选：deepseek / openai / qwen / moonshot / zhipu / ollama / custom
# 解析顺序：① 界面下拉框显式选择 → ② 本变量 → ③ 若设置了旧版 OPENAI_* 变量则用 openai → ④ 兜底 deepseek
LLM_PROVIDER=deepseek

# --- API Key（按预设自动取用；禁止硬编码到源码）---
# DeepSeek（推荐）：申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 通义千问 / 月之暗面 / 智谱（用到对应预设时填）
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
# 通用兜底：任何 OpenAI 兼容网关都可以把 Key 写这里
LLM_API_KEY=

# --- 旧版 OpenAI 兼容变量（保留向后兼容；仅当 LLM_PROVIDER 未设置时生效）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- 默认生成参数（可被界面/单次任务覆盖；留空 = 不发送该字段，用厂商默认值）---
# 单次回复的最大输出 token（含思考内容）。DeepSeek 思考模式建议 ≥2048，否则可能「思考写完、正文为空」
LLM_MAX_TOKENS=
# 0~2，越小越确定（Agent / 工具调用建议 0~0.3）。注意：思考模式下会被厂商忽略
LLM_TEMPERATURE=
# 0~1 核采样（与 temperature 二选一调整即可）
LLM_TOP_P=
# -2~2 重复惩罚 / 新话题倾向
LLM_FREQUENCY_PENALTY=
LLM_PRESENCE_PENALTY=
# 思考模式：enabled / disabled（留空 = 厂商默认；DeepSeek V4 默认开启思考）
LLM_THINKING=
# 思考深度：low / high / max（仅思考模式有效）
LLM_REASONING_EFFORT=

# --- Embedding（切块级 RAG）---
# 默认不设置 = 离线 hash-ngram（词法替身，测试可离线跑）。
# 设置 MTA_EMBEDDING_MODEL 后启用真实 OpenAI 兼容 embedding；换模型必须重建索引。
MTA_EMBEDDING_MODEL=
MTA_EMBEDDING_BASE_URL=https://api.openai.com/v1
MTA_EMBEDDING_API_KEY=
# 可选：覆盖模型默认维度（如 text-embedding-3-small 用 512 省存储）
MTA_EMBEDDING_DIM=
# 写入后是否在后台补索引（默认 false = 下次检索时同步增量补齐）。
# 服务端建议 true：新文档入库后不挡检索；后台失败会留到下次检索重试。
MTA_RAG_BACKGROUND_INDEX=false
# RAG 文档数上限（默认 50000；内存索引的安全线，超过前应先换外部向量索引）
MTA_RAG_MAX_DOCS=50000

# --- 搜索 Provider（Research Agent 使用）---
# 真实搜索需要 API Key。未配置时使用明确标注的离线资料 Provider（OFFLINE_MOCK）。
SEARCH_PROVIDER=offline
SEARCH_API_KEY=
# 真实 Provider 示例: Serper (https://google.serper.io/search)
SEARCH_BASE_URL=https://google.serper.io/search

# --- Runtime 默认预算与限制（可被每个任务请求覆盖）---
# 单次任务最大 Agent Loop 步骤数
DEFAULT_MAX_STEPS=12
# 单次任务最大模型调用次数
DEFAULT_MAX_MODEL_CALLS=20
# 单次任务最大工具调用次数
DEFAULT_MAX_TOOL_CALLS=40
# 单次任务总超时（毫秒）
DEFAULT_TOTAL_TIMEOUT_MS=120000
# 单次任务累计 Token 预算（输入+输出，超出即停止并标记 limit_reached；估算用）
DEFAULT_TOKEN_BUDGET=200000
# 单次任务费用预算（美元，估算）。0 表示不限制。
DEFAULT_COST_BUDGET_USD=0

# --- 工具并发上限 ---
MAX_TOOL_CONCURRENCY=4

# --- HTTP 监听与访问控制 ---
# 默认只监听回环地址（127.0.0.1）。改成 0.0.0.0 / 局域网 IP 时**必须**配置 MTA_AUTH_TOKEN（至少 32 字符），
# 否则服务拒绝启动。浏览器首次访问 http://<host>:3000/?token=<token> 会写入 HttpOnly Cookie。
# 注意：当前只提供 HTTP，token 在非回环网络上仍是明文传输；跨机器使用请放在 HTTPS 反向代理之后。
MTA_HOST=127.0.0.1
MTA_AUTH_TOKEN=

# 同时活动的 run 上限（queued/running/waiting_tool/awaiting_user），防止接口/定时任务把进程堆爆
MAX_ACTIVE_RUNS=64

# 浏览器错误上报限流（每 IP 每分钟；0 = 关闭）
CLIENT_ERRORS_PER_MIN=30

# 数据保留：/api/maintenance 用它计算清理候选（不会自动删除；删除需显式 confirm）
DATA_RETENTION_DAYS=30

# --- SQLite 存储路径 ---
SQLITE_PATH=./data/runtime.db

# --- 多 Agent 编排（主 Agent 调度 + 并行子 Agent）---
# 子任务并发与宽度上限（请求只能收紧，不能放宽）
SUBAGENT_MAX_CONCURRENCY=4
SUBAGENT_MAX_WIDTH=4
# 深度：MVP 固定 1（子 Agent 的上下文不注入派发能力 → 结构上无法再委派）
SUBAGENT_MAX_DEPTH=1
# 单个子任务结果回传主 Agent 的字符上限（上下文纪律）
SUBAGENT_RESULT_CHARS=800
# 编排主 Agent（负责拆分与汇总）的预算；子 Agent 预算另计，互不侵占
ORCH_MAX_STEPS=8
ORCH_MAX_MODEL_CALLS=12
ORCH_MAX_TOOL_CALLS=12
ORCH_TOKEN_BUDGET=200000
ORCH_TOTAL_TIMEOUT_MS=300000
# 是否把只读工具也给主 Agent（默认 false = 只委派+汇总，边界更干净、并行收益更纯）
ORCH_ALLOW_SELF_TOOLS=false

# --- 杂项 Agent（Misc：杂项与低优先级琐事，只读）---
# 默认预算刻意很小；且 maxSteps/maxModelCalls 有硬上限：请求只能收紧、不能放宽
MISC_MAX_STEPS=6
MISC_MAX_MODEL_CALLS=6
MISC_MAX_TOOL_CALLS=10
MISC_TOKEN_BUDGET=50000
MISC_HARD_MAX_STEPS=12
# 目录扫描条目上限（防大目录空转）与单文件读取上限（字节）
MISC_SCAN_LIMIT=5000
MISC_MAX_FILE_BYTES=262144

# --- 受限测试执行器（Codebase run_tests 工具）---
# 是否允许 run_tests 真正执行命令（仅应在隔离/专用仓库启用）
CODEBASE_RUN_TESTS_ENABLED=false
# 允许的测试命令白名单（逗号分隔）。模型不能传入任意命令。
ALLOWED_TEST_COMMANDS=npm test,node --test,npx vitest run

# --- 写能力（沙箱 + 三级人工审批）---
# 写能力是否可用（默认 true）。写操作仍必须：① 任务在编排面板勾选「允许修改文件」授权本 run；
# ② 改动先进入 Docker 沙箱跑检查阶梯（L0 语法 / L1 类型+测试）；③ 落盘前需人工审批。
# 设为 false = 整机禁用（界面会显示"写能力已被部署配置禁用"）。
# CODEBASE_WRITE_ENABLED=true
# 沙箱镜像与宿主复验的 Node 路径（一般无需修改）
# SANDBOX_IMAGE=mta-sandbox:node24
# HOST_NODE_PATH=D:/Program Files/nodejs/node.exe
# 崩溃对账：启动时自动恢复「编辑操作 + 文件在崩溃窗口内消失 + 有原文备份」。
# 只处理这一种确定性的坏状态；已落盘的编辑/新增永不自动回滚（由 /api/runs/:id/recovery 交给人决定）。
RECOVERY_AUTO_RESTORE_MISSING=true

# --- HTTP 服务 ---
PORT=3000

# --- 实时流式展示（Live View / SSE）---
# 是否把模型增量（llm_delta 文本增量）通过 SSE 实时通道推送（不落盘）。
# 服务端入口默认开启；设为 false 可完全关闭（测试/CI 行为与引入前一致，零增量事件）。
STREAM_LIVE_DELTAS=true
# 仅 Mock Provider：分片之间的演示延迟（毫秒），用于肉眼观察逐字输出。0 = 全速。
MOCK_STREAM_CHUNK_DELAY_MS=25
# 单个文本增量的最大字符数（Mock 分片粒度）
STREAM_CHUNK_CHARS=18
# SSE 心跳间隔（毫秒）：防止代理/浏览器判定连接空闲
STREAM_HEARTBEAT_MS=15000
# SSE 看门狗轮询间隔（毫秒）：补漏（异步落盘延迟）与终态收尾
STREAM_WATCHDOG_MS=2000
# 是否输出 SSE 连接生命周期与帧级调试日志（排查「收不到流」时开）
STREAM_DEBUG=false
# 同时打开的 SSE 连接上限（超出返回 429；消费慢时服务端会丢弃临时 delta，持久事件不丢）
STREAM_MAX_CONNECTIONS=32

# --- 错误报告 ---
# 统一错误报告（JSONL）落盘路径：每条一行，含位置/类型/码/消息/上下文/栈，便于 grep 取证
ERROR_LOG_PATH=./data/errors.log

# --- 日志 ---
# 模型上下文/网页/代码内容在日志中的最大字符数（防止日志泄露大段敏感内容）
LOG_MAX_CONTENT_CHARS=2000
# 是否在日志中打印工具结果正文（true/false）
LOG_TOOL_RESULTS=false
# errors.log 单文件大小上限（字节）；超过后轮转为 errors.log.1（0 = 不轮转）
ERROR_LOG_MAX_BYTES=10485760

# --- MCP 外部工具（Streamable HTTP，可选）---
# 留空 = 不连接任何外部 MCP。配置为 JSON 数组；每个 server 必须显式给 names 白名单，
# 否则 54 个工具 schema 会全量进上下文。
# 字段：name（1~40 位字母/数字/_/-，多 server 时唯一）、url（http/https，禁止内嵌账号密码）、
#       names（要暴露的 MCP 工具名数组，最多 100 个）、token（可选 Bearer）、timeoutMs（1000~120000，默认 15000）。
# 工具在模型侧的名字是 mcp_<name>_<toolName>；启动后 GET /api/mcp 查看连接状态（不回显 token）。
# ⚠️ 不要把真实 token 写进这个模板文件——复制到 .env，或用系统环境变量。
MTA_MCP_SERVERS=[]
# 示例（token 请留空或换成占位符）：
# MTA_MCP_SERVERS=[{"name":"hub","url":"http://127.0.0.1:9060/mcp","token":"","names":["kb_search"],"timeoutMs":15000}]

# --- Codex 直连（本机 CLI，可选）---
# 关闭后不接受 runType=codex，也不注册 codex_exec 工具。
MTA_CODEX_ENABLED=true
# 可执行文件（默认 codex；Windows 下自动解析 .cmd shim → 包内 codex.js）
MTA_CODEX_BIN=codex
# 覆盖本机默认模型（留空 = 用 ~/.codex/config.toml 的 model）。
# 本机 DeepSeek 端点只接受 deepseek-flash / deepseek-v4-pro。
MTA_CODEX_MODEL=
# 单次执行上限（毫秒）与 stdout/事件缓冲上限（字节）
MTA_CODEX_TIMEOUT_MS=600000
MTA_CODEX_MAX_OUTPUT_BYTES=4194304
# 是否旁路读取 ~/.codex/sessions 的 rollout 拿思考文本（best-effort；失败自动降级，不影响答案）
MTA_CODEX_REASONING_TAP=true
# 最终答案回传/落库的字符上限
MTA_CODEX_SUMMARY_CHARS=20000
